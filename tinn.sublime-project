{
	"folders":
	[
		{
			"path": "src"
		},
		{
			"name": "settings",
			"path": ".",
			"folder_exclude_patterns": ["*"]
		}
	],
	"build_systems":
	[
		{
			"name": "Build Project",

			"target": "terminus_exec",
			"cancel": "terminus_cancel_build",

			"working_dir": "$project_path",
			"cmd": ["make"],

			"variants":			
			[
				{
					"name": "run",
					"target": "terminus_exec",
					"cancel": "terminus_cancel_build",
					"cmd": ["make", "run"]
				},
				{
					"name": "test",
					"target": "terminus_exec",
					"cancel": "terminus_cancel_build",
					"cmd": ["make", "test"]
				},
				{
					"name": "debug",
					"target": "exec",
					"cancel": null,
					"shell_cmd": "make && kdbg -a test ./build/tinn"
				}
			]
		}
	]
}
